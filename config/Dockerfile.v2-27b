FROM harbor-contest.4pd.io/zengzhitao/resume-copilot@sha256:644e77e9bcfdb38d2be94c3b86da39b9bbf8c6d7d147d80465cf4875ea912e62

# Compatibility overlay for the historical 27B image. Keep the complete core
# together so schema/security changes cannot drift across image variants.
COPY core/*.py /root/app/core/
COPY main.py drafts.py http_compat.py /root/app/
COPY start_api.sh /root/app/start_api.sh

ENV PYTHONPATH=/root/app/core
RUN chmod +x /root/app/start_api.sh
CMD ["/root/app/start_api.sh"]
